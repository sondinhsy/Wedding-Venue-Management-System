<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<VBox spacing="16" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="📊 Tổng quan hệ thống" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
    
    <!-- Charts Section -->
    <HBox spacing="16" HBox.hgrow="ALWAYS" prefHeight="350">
        <!-- Pie Chart - Tỷ trọng doanh thu theo mặt hàng -->
        <VBox styleClass="card" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" prefWidth="400">
            <Label text="Tỷ trọng doanh thu theo mặt hàng" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 0 0 8 0;"/>
            <PieChart fx:id="menuRevenueChart" prefHeight="300" VBox.vgrow="ALWAYS" legendSide="RIGHT"/>
            <!-- Legend labels sẽ được thêm bởi controller -->
        </VBox>
        
        <!-- Donut Chart - Doanh thu theo tháng -->
        <VBox styleClass="card" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" prefWidth="400">
            <Label text="Doanh thu theo tháng" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-padding: 0 0 8 0;"/>
            <StackPane fx:id="donutChartPane" prefHeight="300" VBox.vgrow="ALWAYS">
                <PieChart fx:id="serviceTypeChart" prefHeight="300" VBox.vgrow="ALWAYS" legendSide="RIGHT" labelsVisible="false"/>
                <Circle radius="80" fill="white"/>
            </StackPane>
        </VBox>
    </HBox>
    
    <!-- Statistics Cards -->
    <HBox spacing="16" HBox.hgrow="ALWAYS">
        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="👥 Tổng khách hàng" style="-fx-font-size: 13px;"/>
            <Label fx:id="customerCountLabel" styleClass="metric"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="📅 Tổng booking" style="-fx-font-size: 13px;"/>
            <Label fx:id="bookingCountLabel" styleClass="metric"/>
        </VBox>
        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefWidth="200">
            <Label text="💰 Tổng doanh thu" style="-fx-font-size: 13px;"/>
            <Label fx:id="revenueLabel" styleClass="metric"/>
        </VBox>
    </HBox>
    
    <!-- Booking Table -->
    <Label text="📋 Danh sách booking" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a; -fx-padding: 8 0;"/>
    <TableView fx:id="bookingTable" prefHeight="300" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colBookingCode" text="Mã" prefWidth="90"/>
            <TableColumn fx:id="colBookingCustomer" text="Khách hàng" prefWidth="150"/>
            <TableColumn fx:id="colBookingHall" text="Sảnh" prefWidth="120"/>
            <TableColumn fx:id="colBookingDate" text="Ngày" prefWidth="100"/>
            <TableColumn fx:id="colBookingTables" text="Bàn" prefWidth="60"/>
            <TableColumn fx:id="colBookingTotal" text="Tổng tiền" prefWidth="150"/>
            <TableColumn fx:id="colBookingMenu" text="Thực đơn" prefWidth="220"/>
            <TableColumn fx:id="colBookingPaymentStatus" text="Trạng thái thanh toán" prefWidth="140"/>
            <TableColumn fx:id="colBookingActions" text="Thao tác" prefWidth="230"/>
        </columns>
    </TableView>
</VBox>
